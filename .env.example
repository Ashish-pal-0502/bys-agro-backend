# Copy to .env and fill in. Names below are exactly what the code reads.

# ---- Server ----
PORT=5000
NODE_ENV=production
# Number of proxies in front of this server (nginx / load balancer = 1). Without it every visitor
# shares one rate-limit bucket. Leave 0 if the server is exposed directly.
TRUST_PROXY=1

# ---- Database ----
MONGO_URI=

# ---- Auth ----
# Long random string used to sign login tokens
SECRET_KEY=
# Same value as the storefront's NEXT_PUBLIC_GOOGLE_CLIENT_ID. Google login returns 500 without it.
GOOGLE_CLIENT_ID=

# ---- Payments (Razorpay) ----
RAZOR_PAY_ID=
RAZOR_PAY_SECRET=

# ---- Image storage (S3) ----
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_BUCKET=
AWS_BUCKET_REGION=

# ---- Shipping (Shiprocket) ----
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASS=

# ---- Email (one mailbox per purpose) ----
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
ORDER_EMAIL=
ORDER_PASS=
SUPPORT_EMAIL=
SUPPORT_PASS=
CART_EMAIL=
CART_PASS=
VERIFY_EMAIL=
VERIFY_PASS=
HELP_EMAIL=
HELP_PASS=
USER_EMAIL=
USER_PASS=

# ---- SMS / WhatsApp ----
FAST2SMS_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
